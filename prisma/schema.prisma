generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "listing", "booking", "payment", "notification"]
}

// =============================================================================
// Schema: identity
// =============================================================================

enum UserRole {
  TENANT
  LANDLORD
  ADMIN

  @@schema("identity")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@schema("identity")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("identity")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  role            UserRole         @default(TENANT)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  landlordProfile LandlordProfile?

  @@schema("identity")
}

model LandlordProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  fullName       String
  idNumber       String?
  kycStatus      KycStatus @default(PENDING)
  commissionRate Decimal?  @db.Decimal(5, 4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("identity")
}

// =============================================================================
// Schema: listing
// =============================================================================

enum RoomType {
  BOARDING
  SERVICED_APT
  LUXURY_LONG_TERM

  @@schema("listing")
}

enum RoomStatus {
  AVAILABLE
  HELD
  OCCUPIED
  HIDDEN

  @@schema("listing")
}

enum MediaKind {
  PHOTO
  PANORAMA

  @@schema("listing")
}

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  landlordId String   @db.Uuid
  name       String
  address    String
  district   String
  city       String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rooms      Room[]

  @@index([landlordId])
  @@index([city, district])
  @@schema("listing")
}

model Room {
  id           String         @id @default(uuid()) @db.Uuid
  buildingId   String         @db.Uuid
  code         String
  title        String
  type         RoomType
  monthlyRent  BigInt
  areaSqm      Float
  status       RoomStatus     @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  media        RoomMedia[]
  panoScenes   PanoScene[]
  amenities    RoomAmenity[]
  availability Availability[]

  @@index([buildingId])
  @@index([type, status])
  @@schema("listing")
}

model RoomMedia {
  id           String    @id @default(uuid()) @db.Uuid
  roomId       String    @db.Uuid
  kind         MediaKind
  url          String
  thumbnailUrl String?
  sortOrder    Int       @default(0)
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@schema("listing")
}

model PanoScene {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  title     String
  imageUrl  String
  hotspots  Json     @default("[]")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@schema("listing")
}

model Amenity {
  id    String        @id @default(uuid()) @db.Uuid
  code  String        @unique
  name  String
  icon  String?
  rooms RoomAmenity[]

  @@schema("listing")
}

model RoomAmenity {
  roomId    String  @db.Uuid
  amenityId String  @db.Uuid
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@schema("listing")
}

model Availability {
  id            String    @id @default(uuid()) @db.Uuid
  roomId        String    @db.Uuid
  availableFrom DateTime  @db.Date
  availableTo   DateTime? @db.Date
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@schema("listing")
}

// =============================================================================
// Schema: booking
// =============================================================================

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED

  @@schema("booking")
}

enum BookingStatus {
  PENDING
  DEPOSIT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@schema("booking")
}

model ViewingSlot {
  id          String        @id @default(uuid()) @db.Uuid
  roomId      String        @db.Uuid
  tenantId    String        @db.Uuid
  landlordId  String        @db.Uuid
  scheduledAt DateTime
  status      ViewingStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([roomId, scheduledAt])
  @@index([tenantId])
  @@schema("booking")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  roomId         String        @db.Uuid
  tenantId       String        @db.Uuid
  landlordId     String        @db.Uuid
  moveInDate     DateTime      @db.Date
  firstMonthRent BigInt
  depositAmount  BigInt        @default(0)
  status         BookingStatus @default(PENDING)
  holdExpiresAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([roomId, status])
  @@index([tenantId])
  @@index([landlordId])
  @@schema("booking")
}

// =============================================================================
// Schema: payment
// =============================================================================

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED

  @@schema("payment")
}

enum CommissionStatus {
  ACCRUED
  SETTLED
  VOIDED

  @@schema("payment")
}

enum SettingScopeType {
  GLOBAL
  ROOM_TYPE
  LANDLORD

  @@schema("payment")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @db.Uuid
  orderCode     BigInt        @unique
  paymentLinkId String?
  amount        BigInt
  provider      String        @default("PAYOS")
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@schema("payment")
}

model Commission {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @unique @db.Uuid
  rate       Decimal          @db.Decimal(5, 4)
  baseAmount BigInt
  amount     BigInt
  status     CommissionStatus @default(ACCRUED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@schema("payment")
}

model PlatformSetting {
  id        String           @id @default(uuid()) @db.Uuid
  key       String
  value     Json
  scopeType SettingScopeType @default(GLOBAL)
  scopeId   String?
  updatedAt DateTime         @updatedAt

  @@unique([key, scopeType, scopeId])
  @@schema("payment")
}

// =============================================================================
// Schema: notification
// =============================================================================

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  channel   String
  event     String
  payload   Json
  sentAt    DateTime @default(now())

  @@index([userId])
  @@schema("notification")
}

{
  "name": "roomhub-api",
  "version": "0.1.0",
  "description": "NestJS microservices monorepo for RoomHub Platform",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api-gateway && nest build identity-service && nest build listing-service && nest build booking-service && nest build payment-service && nest build notification-service",
    "build:gateway": "nest build api-gateway",
    "build:identity": "nest build identity-service",
    "build:listing": "nest build listing-service",
    "build:booking": "nest build booking-service",
    "build:payment": "nest build payment-service",
    "build:notification": "nest build notification-service",
    "dev": "concurrently -n gateway,identity,listing,booking,payment,notify -c blue,green,yellow,magenta,cyan,white \"pnpm start:gateway:dev\" \"pnpm start:identity:dev\" \"pnpm start:listing:dev\" \"pnpm start:booking:dev\" \"pnpm start:payment:dev\" \"pnpm start:notification:dev\"",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:identity:dev": "nest start identity-service --watch",
    "start:listing:dev": "nest start listing-service --watch",
    "start:booking:dev": "nest start booking-service --watch",
    "start:payment:dev": "nest start payment-service --watch",
    "start:notification:dev": "nest start notification-service --watch",
    "start:dev": "pnpm dev",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.4.1",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "http-proxy-middleware": "^3.0.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "roots": ["<rootDir>/apps/", "<rootDir>/libs/"],
    "moduleNameMapper": {
      "^@common$": "<rootDir>/libs/common/src",
      "^@common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@contracts$": "<rootDir>/libs/contracts/src",
      "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1"
    }
  }
}
